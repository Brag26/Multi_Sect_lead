# Local: copy to .env. On Vercel: add these under Project Settings > Environment Variables.

# Lock the app (strongly recommended once it is on the internet)
APP_PASSWORD=

# Your email, sent to OpenStreetMap as required by their usage policy
CONTACT_EMAIL=

# Optional sources. OpenStreetMap works with no key.
GOOGLE_PLACES_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
OPENCORPORATES_TOKEN=

# Consumer lead storage. Vercel fills these in when you add Upstash Redis from Storage.
# (Names may be UPSTASH_REDIS_REST_URL / _TOKEN or KV_REST_API_URL / _TOKEN. Both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
